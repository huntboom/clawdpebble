WATCH_BRIDGE_BIND=0.0.0.0
WATCH_BRIDGE_PORT=18790
WATCH_BRIDGE_TOKEN=replace-me
OPENCLAW_GATEWAY_TOKEN=replace-me
OPENCLAW_HOOKS_TOKEN=replace-me
PEBBLE_SESSION_KEY=agent:main:pebble-remote
PEBBLE_AGENT_ID=main
PEBBLE_AGENT_TIMEOUT=90
PEBBLE_MAX_REPLY_CHARS=480
# Your LAN IP for same-Wi-Fi access (never commit the real value — lives in pc/.env)
LAN_IP=192.168.x.x
LAN_BRIDGE_URL=http://192.168.x.x:18790
PUBLIC_BRIDGE_URL=https://your-tunnel.trycloudflare.com
